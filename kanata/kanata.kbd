;; tap-hold-press: ホールド中に他のキーが押された時点で即ホールド判定するため、連打してもタップが誤発火しない。
;;
;; 導入: kanata_gui.exe と同じフォルダに "kanata.kbd" として配置すると自動読み込みされる(symlinkでも可)。
;;       複数ファイルを切り替えたい場合はショートカットの引数に --cfg <path> を指定する。

(defcfg)

(defsrc
  ncnv
  1    2    3    4    5    6    7    8    9    0
  b    d
  u    i    o
  j    k    l
  n    m    ,    .
  spc
)

(defalias
  ncnv (tap-hold-press 200 200 ncnv (layer-while-held numbers))
  spc  (tap-hold-press 200 200 spc  (layer-while-held space))
)

(deflayer base
  @ncnv
  1    2    3    4    5    6    7    8    9    0
  b    d
  u    i    o
  j    k    l
  n    m    ,    .
  @spc
)

(deflayer numbers
  _
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10
  bspc del
  7    8    9
  4    5    6
  0    1    2    3
  _
)

(deflayer space
  _
  _    _    _    _    _    _    _    _    _    _
  _    _
  _    _    _
  _    _    _
  _    _    bspc del
  _
)
